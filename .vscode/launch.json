{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
  {
    "name": "Go Debug",
    "type": "go",
    "request": "launch",
    "mode": "auto",
    "env": {"STORAGE_SECRET":"asdfghjklasdfghjklasdfghjklasdfg"},
    "program": "${workspaceFolder}/backend/cmd",
    // without --dir PocketBase uses pb_data next to the program, i.e. backend/cmd/pb_data
    "args": ["serve", "--dir", "${workspaceFolder}/pb_data"]
  },
    {
      "name": "Frontend (Vite)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: dev - frontend",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}
